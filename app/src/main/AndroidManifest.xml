<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- Internet access -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Storage permissions (deprecated on Android 10+, but needed for < Q) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Allow installing APKs outside Play Store -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Optional: Uncomment if needed -->
     <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" /> -->
    <!-- <uses-permission android:name="android.permission.CAMERA" /> -->
    <!-- <uses-permission android:name="android.permission.READ_CONTACTS" /> -->

    <application
        android:name="com.example.groceryshoppingapp.MyApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.GroceryShoppingApp"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">

        <!-- FileProvider for APK installation -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Launcher Activity -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Firebase Messaging Service -->
        <service
            android:name="com.example.groceryshoppingapp.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Other Activities -->
        <activity android:name="com.example.groceryshoppingapp.AddItemsActivity"/>
        <activity android:name="com.example.groceryshoppingapp.CartActivity" />
        <activity android:name="com.example.groceryshoppingapp.CartShopListActivity" />
        <activity android:name="com.example.groceryshoppingapp.ChangePasswordActivity" />
        <activity android:name="com.example.groceryshoppingapp.CreateShopActivity"
            android:exported="false" />
        <activity android:name="com.example.groceryshoppingapp.CustomerActivity" />
        <activity android:name="com.example.groceryshoppingapp.CustomerHomeActivity" />
        <activity android:name="com.example.groceryshoppingapp.CustomerItemsActivity" />
        <activity android:name="com.example.groceryshoppingapp.CustomerOrdersActivity" />
        <activity android:name="com.example.groceryshoppingapp.EditProfileActivity" />
        <activity android:name="com.example.groceryshoppingapp.ForgotPasswordActivity"/>
        <activity android:name="com.example.groceryshoppingapp.HelpActivity"/>
        <activity android:name="com.example.groceryshoppingapp.LanguageSelectionActivity"/>
        <activity android:name="com.example.groceryshoppingapp.LoginActivity" />
        <activity android:name="com.example.groceryshoppingapp.MainActivity" />
        <activity android:name="com.example.groceryshoppingapp.ManageItemsActivity"/>
        <activity android:name="com.example.groceryshoppingapp.OrderConfirmActivity" />
        <activity android:name="com.example.groceryshoppingapp.OrderDetailActivity" />
        <activity android:name="com.example.groceryshoppingapp.OrderPlacedActivity" />
        <activity android:name="com.example.groceryshoppingapp.OrderSummaryActivity" />
        <activity android:name="com.example.groceryshoppingapp.ProfileActivity"/>
        <activity android:name="com.example.groceryshoppingapp.RegisterActivity" />
        <activity android:name="com.example.groceryshoppingapp.SettingsActivity" />
        <activity android:name="com.example.groceryshoppingapp.ShopItemsActivity" />
        <activity android:name="com.example.groceryshoppingapp.ShopkeeperOrdersActivity" />
        <activity android:name="com.example.groceryshoppingapp.ShopOwnerDashboardActivity" />
        <activity android:name="com.example.groceryshoppingapp.ShopOwnerMainActivity" />
        <activity android:name="com.example.groceryshoppingapp.ShopSelectionActivity" />
        <activity android:name="com.example.groceryshoppingapp.ThankYouActivity" />
        <activity android:name="com.example.groceryshoppingapp.UpdateItemActivity"/>
        <activity android:name="com.example.groceryshoppingapp.InvoiceViewActivity"/>
        <activity android:name="com.example.groceryshoppingapp.WalletActivity"/>
        <activity android:name="com.example.groceryshoppingapp.ShopKhataListActivity"/>
        <activity android:name="com.example.groceryshoppingapp.KhataCustomerDetailActivity"/>
        <activity android:name="com.example.groceryshoppingapp.CustomerKhataListActivity"/>
        <activity android:name="com.example.groceryshoppingapp.ShopOwnerSelectCustomerActivity"/>
        <activity android:name="com.example.groceryshoppingapp.ShopOwnerWalletActivity"/>
        <activity android:name="com.example.groceryshoppingapp.ShopkeeperAnalyticsActivity"/>


    </application>
</manifest>
