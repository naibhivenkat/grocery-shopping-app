<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <!-- Shop name -->
    <TextView
        android:id="@+id/text_shop_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Shop:"
        android:textStyle="bold"
        android:textSize="16sp" />

    <!-- Order status -->
    <TextView
        android:id="@+id/text_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status:" />

    <TextView
        android:id="@+id/text_created_at"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Created At:" />

    <!-- Payment info -->
    <TextView
        android:id="@+id/text_payment_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Payment:"
        android:visibility="gone" />

    <TextView
        android:id="@+id/text_partial_refund"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FF5722"
        android:textSize="16sp"
        android:textStyle="bold"
        android:padding="10dp"
        android:visibility="gone"
        android:background="#FFF3E0"/>

    <!-- 🔴 ADDED: Order total -->
    <TextView
        android:id="@+id/text_order_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:text="Total: ₹0.00"
        android:layout_marginTop="6dp"/>
    <!-- 🔴 ADDED: Refund info for customer -->
    <TextView
        android:id="@+id/text_refund_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#2E7D32"
        android:padding="8dp"
        android:visibility="gone"
        android:layout_marginTop="6dp"/>




    <!-- Spinner + Cancel msg -->
    <Spinner
        android:id="@+id/spinner_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

    <EditText
        android:id="@+id/edit_cancel_msg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter cancel message"
        android:visibility="gone" />

    <!-- Recycler for items -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_items"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingVertical="8dp" />

    <!-- Buttons row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Refresh" />

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back"
            android:layout_marginStart="12dp" />
    </LinearLayout>

    <!-- 🔹 Save Changes Button for shopkeepers -->
    <Button
        android:id="@+id/btn_save_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save Changes"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_update_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Update Status"
        android:layout_marginTop="8dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_invoice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="View Invoice"
        android:visibility="gone"
        android:layout_marginTop="12dp"/>

</LinearLayout>
