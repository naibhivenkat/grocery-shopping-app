<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/card_bg">

    <!-- Item name -->
    <TextView
        android:id="@+id/tv_item_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Item Name"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="?attr/colorOnSurface" />

    <!-- Editable section (for shopkeeper only) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <EditText
            android:id="@+id/et_item_quantity"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:hint="Qty"
            android:visibility="gone"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurface" />

        <!-- ✅ NEW: Label to show original ordered amount -->
        <TextView
            android:id="@+id/tv_ordered_qty_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="/ 5"
            android:textSize="14sp"
            android:textStyle="italic"
            android:layout_marginStart="8dp"
            android:textColor="#757575"
            android:visibility="gone" />
    </LinearLayout>

    <EditText
        android:id="@+id/et_item_price"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="numberDecimal"
        android:hint="Price (₹)"
        android:visibility="gone"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/colorOnSurface" />

    <EditText
        android:id="@+id/et_item_comment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Add comment (optional)"
        android:visibility="gone"
        android:textColor="?attr/colorOnSurface"
        android:textColorHint="?attr/colorOnSurface" />

    <!-- Read-only section (for customer only) -->
    <TextView
        android:id="@+id/tv_item_quantity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Qty: 0"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/tv_item_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="₹ 0.00"
        android:textColor="?attr/colorOnSurface" />

    <TextView
        android:id="@+id/tv_item_comment"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comment: —"
        android:textColor="?attr/colorOnSurface"
        android:visibility="gone" />

</LinearLayout>