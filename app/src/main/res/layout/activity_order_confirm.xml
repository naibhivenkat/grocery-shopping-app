<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- TITLE -->
        <TextView
            android:id="@+id/textViewTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Confirm Your Order"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/purple_700"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/textViewShopName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/textViewTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="@color/teal_700"
            android:layout_marginBottom="20dp" />

        <!-- PAY NOW -->
        <TextView
            android:id="@+id/textViewPayNowLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter Amount to Pay Now"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/editTextPayNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:padding="12dp"
            android:background="@drawable/rounded_input"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/textViewDueAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Due: ₹0"
            android:textSize="16sp"
            android:textColor="@android:color/black"
            android:layout_marginBottom="18dp" />

        <!-- UPI CARD -->
        <LinearLayout
            android:id="@+id/optionUpi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:background="@drawable/payment_option_selector"
            android:elevation="6dp"
            android:foreground="?attr/selectableItemBackground"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_upi"
                android:layout_marginRight="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="UPI / Online Payments"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/tickUpi"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tick"
                android:visibility="gone" />
        </LinearLayout>

        <!-- WALLET CARD -->
        <LinearLayout
            android:id="@+id/optionWallet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp"
            android:background="@drawable/payment_option_selector"
            android:elevation="6dp"
            android:foreground="?attr/selectableItemBackground"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:src="@drawable/ic_wallet"
                    android:layout_marginRight="12dp" />

                <TextView
                    android:id="@+id/txtWalletTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Wallet"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/tickWallet"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_tick"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtWalletBalance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Balance: --"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:visibility="gone"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/txtWalletError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Insufficient Balance!"
                android:textStyle="bold"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="14sp"
                android:visibility="gone"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/btnCheckWallet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Check Balance"
                android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- CASH CARD -->
        <LinearLayout
            android:id="@+id/optionCash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:background="@drawable/payment_option_selector"
            android:foreground="?attr/selectableItemBackground"
            android:elevation="6dp"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_cash"
                android:layout_marginRight="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cash"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/tickCash"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tick"
                android:visibility="gone" />
        </LinearLayout>

        <!-- KHATA CARD -->
        <LinearLayout
            android:id="@+id/optionKhata"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="18dp"
            android:background="@drawable/payment_option_selector"
            android:foreground="?attr/selectableItemBackground"
            android:elevation="6dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_khata"
                android:layout_marginRight="12dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Khata (Credit)"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/tickKhata"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tick"
                android:visibility="gone" />
        </LinearLayout>

        <Button
            android:id="@+id/buttonPlaceOrder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PLACE ORDER"
            android:padding="12dp"
            android:textAllCaps="true" />
    </LinearLayout>
</ScrollView>
