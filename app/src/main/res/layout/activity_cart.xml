<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cart_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="?android:colorBackground"
    android:focusable="true"
    android:focusableInTouchMode="true">  <!-- 👈 Add these two lines -->


    <TextView
        android:id="@+id/textViewCartTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ui_your_cart"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?android:textColorPrimary"
        android:layout_gravity="center_horizontal"
        android:paddingBottom="10dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewCart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/textViewTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ui_total_000_3"
        android:textSize="18sp"
        android:textColor="?android:textColorPrimary"
        android:layout_marginTop="10dp" />

    <TextView
        android:id="@+id/emptyCartTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ui_your_cart_is_empty"
        android:textSize="16sp"
        android:visibility="gone"
        android:gravity="center"
        android:paddingTop="20dp"
        />


    <Button
        android:id="@+id/buttonConfirmOrder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ui_confirm_order"
        android:layout_marginTop="10dp"
        android:backgroundTint="@android:color/holo_green_dark"
        android:textColor="?android:textColorPrimaryInverse" />

    <Button
        android:id="@+id/buttonBackToShop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/ui_back_to_items"
        android:layout_marginTop="6dp"
        android:backgroundTint="@android:color/holo_red_dark"
        android:textColor="?android:textColorPrimaryInverse" />
</LinearLayout>
