<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.GroceryShoppingApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Disable default action bar so we can use Toolbar -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>

        <!-- Brand colors -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>

        <!-- Background / surface colors for light mode -->
        <item name="android:colorBackground">@color/light_background</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@android:color/black</item>

        <!-- Default text colors -->
        <item name="android:textColorPrimary">@color/text_primary_light</item>
        <item name="android:textColorSecondary">@color/text_secondary_light</item>

        <!-- Card style for Material CardViews -->
        <item name="materialCardViewStyle">@style/KhataCardStyle</item>
    </style>

    <!-- Shared card style -->
    <style name="KhataCardStyle" parent="@style/Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card_light</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">5dp</item>
        <item name="cardUseCompatPadding">true</item>
    </style>

</resources>
