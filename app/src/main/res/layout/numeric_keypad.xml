<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/numericKeypadLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/colorSurface"
    android:padding="12dp"
    android:gravity="center">

    <!-- Number Buttons Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:layout_marginBottom="12dp">

        <!-- Row 1 -->
        <Button
            android:id="@+id/btn1"
            style="@style/KeypadButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="1"/>
        <Button
            android:id="@+id/btn2"
            style="@style/KeypadButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="2"/>
        <Button
            android:id="@+id/btn3"
            style="@style/KeypadButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="3"/>

        <!-- Row 2 -->
        <Button
            android:id="@+id/btn4"
            style="@style/KeypadButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="4"/>
        <Button
            android:id="@+id/btn5"
            style="@style/KeypadButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="5"/>
        <Button
            android:id="@+id/btn6"
            style="@style/KeypadButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="6"/>

        <!-- Row 3 -->
        <Button
            android:id="@+id/btn7"
            style="@style/KeypadButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="7"/>
        <Button
            android:id="@+id/btn8"
            style="@style/KeypadButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="8"/>
        <Button
            android:id="@+id/btn9"
            style="@style/KeypadButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="9"/>

        <!-- Row 4 -->
        <Button
            android:id="@+id/btnClear"
            style="@style/KeypadButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="⌫"/>
        <Button
            android:id="@+id/btn0"
            style="@style/KeypadButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="0"/>
        <Button
            android:id="@+id/btnDone"
            style="@style/KeypadButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:text="✔"/>

    </GridLayout>
</LinearLayout>
