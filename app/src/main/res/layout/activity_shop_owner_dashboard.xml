<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Main Content -->
    <LinearLayout
        android:id="@+id/content_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Toolbar -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?attr/colorPrimary"
            app:title="Shop Owner Dashboard"
            app:titleTextColor= "?android:textColorPrimaryInverse" />

        <!-- Buttons/content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center"
            android:background="?android:attr/colorBackground">

            <TextView
                android:id="@+id/tv_dashboard_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ui_shop_owner_dashboard"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="32dp"
                android:textColor="?android:attr/textColorPrimary" />

            <Button
                android:id="@+id/btn_view_orders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ui_view_orders" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right-side Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:fitsSystemWindows="true"
        android:background="@android:color/white"
        app:menu="@drawable/shopowner_drawer_menu"
        app:itemTextColor="@color/black"
        app:itemIconTint="@color/black" />



</androidx.drawerlayout.widget.DrawerLayout>
